# Required server configuration. Set real values locally in .env and in Vercel.
DATABASE_URL=
JWT_SECRET=

# Required only when running `npm run db:seed`. Never use demo credentials in production.
SEED_ADMIN_PASSWORD=
SEED_MENTOR_PASSWORD=
SEED_STUDENT_PASSWORD=

# Optional service integrations (server-only)
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# AI chat: Gemini is used when GEMINI_API_KEY is set, otherwise the MyBuddy backend below
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# AI chat is answered by the self-hosted MyBuddy backend (service account on that server)
MYBUDDY_API_URL=http://localhost:8000
MYBUDDY_EMAIL=
MYBUDDY_PASSWORD=
# Still used by the admin visual-explanations route only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This identifier is intentionally public; Razorpay requires it in browser code.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://www.myloginn.com

# Optional: Google Search Console URL-prefix property HTML verification token.
# Domain properties are verified with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Astrology service (Python / FastAPI in ./astrology). The Next.js app proxies /api/astrology/* to it.
ASTROLOGY_API_URL=http://127.0.0.1:8765
# Optional shared secret; set the same value on the Python service so only this app can call it.
ASTROLOGY_API_SECRET=

# LogiQuest code execution (see exec-service/README.md). Free setup: a second, secret-free Vercel project.
LQ_EXEC_URL=
LQ_EXEC_TOKEN=
# 1 when LQ_EXEC_URL is the bundled exec-service (one request per submission); unset for a Piston server
LQ_EXEC_BATCH=
# Languages the configured backend can run, comma separated. Free exec-service: python,javascript
LQ_EXEC_LANGUAGES=
