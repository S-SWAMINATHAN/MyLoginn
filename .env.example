# Required server configuration. Set real values locally in .env and in Vercel.
DATABASE_URL=
JWT_SECRET=

# Required only when running `npm run db:seed`. Never use demo credentials in production.
SEED_ADMIN_PASSWORD=
SEED_MENTOR_PASSWORD=
SEED_STUDENT_PASSWORD=

# Optional service integrations (server-only)
# Brevo transactional email (preferred). EMAIL_FROM must be a verified Brevo sender.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=MyLoginn <contact@myloginn.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Website chat uses Puter.js in the browser; no chat provider key is needed.
# Gemini remains available for the separate LMS coach and practice features.
GEMINI_API_KEY=
# Practice (AI interview, speaking lab, group discussion) uses PRACTICE_GEMINI_API_KEY, or GEMINI_API_KEY when that is empty.
# It needs a key with billing enabled:
# the free tier allows only ~20 requests per model per day, and one mock interview is ~9 calls.
PRACTICE_GEMINI_API_KEY=
# Models tried in order when the main one is rate-limited (each model has its own quota).
# PRACTICE_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Group discussion audio is peer-to-peer with free public STUN. On strict networks (some mobile carriers, offices)
# a relay is needed: run the free open-source coturn server with `use-auth-secret` and set both values below.
# Browsers only ever receive short-lived HMAC credentials, never the secret.
# GD_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# GD_TURN_SECRET=
# MyBuddy is used for competition integrity review (service account on that server).
MYBUDDY_API_URL=http://localhost:8000
MYBUDDY_EMAIL=
MYBUDDY_PASSWORD=
# OpenRouter is used by admin visual explanations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This identifier is intentionally public; Razorpay requires it in browser code.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://www.myloginn.com

# Optional: Google Search Console URL-prefix property HTML verification token.
# Domain properties are verified with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Astrology service (Python / FastAPI in ./astrology). The Next.js app proxies /api/astrology/* to it.
ASTROLOGY_API_URL=http://127.0.0.1:8765
# Optional shared secret; set the same value on the Python service so only this app can call it.
ASTROLOGY_API_SECRET=
