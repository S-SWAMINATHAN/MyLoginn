# Required server configuration. Set real values locally in .env and in Vercel.
DATABASE_URL=
JWT_SECRET=

# Required only when running `npm run db:seed`. Never use demo credentials in production.
SEED_ADMIN_PASSWORD=
SEED_MENTOR_PASSWORD=
SEED_STUDENT_PASSWORD=

# Optional service integrations (server-only)
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This identifier is intentionally public; Razorpay requires it in browser code.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://www.myloginn.com
