# pyenv
.python-version

# ────────────────────────────────────────────────────────────
# 2. Database & persistence artefacts
# ────────────────────────────────────────────────────────────
# Local dev SQLite (backend/jathagam.db via app/db/session.py)
# Production uses Postgres via DATABASE_URL — never commit a DB file.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/jathagam.db
backend/*.db
instance/

# ────────────────────────────────────────────────────────────
# 3. Environment variables & secrets — NEVER commit
#    (see AGENTS.md §3.3 Security)
# ────────────────────────────────────────────────────────────
# Keep .env.example tracked as a template; ignore real env files.
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# Backend secrets
backend/.env
backend/.env.*

# Frontend secrets
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Secret managers / cloud
.service_account.json
*credentials*.json
.secrets/

# Swiss Ephemeris commercial license key (if purchased, AGPL vs ~USD500/CHF1550)
# Store via SE_EPHE_PATH + env/secret manager, never in repo
*license*.key
swe_license*

# ────────────────────────────────────────────────────────────
# 4. Node.js / Frontend — Next.js 14 + pnpm + TypeScript
# ────────────────────────────────────────────────────────────
# Dependencies — pnpm uses pnpm-lock.yaml (keep it tracked)
node_modules/
.pnp
.pnp.js
frontend/node_modules/
.pnp/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js build outputs
.next/
out/
build/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/

# Vercel / deployment
.vercel
.now
frontend/.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Turborepo
.turbo/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Keep pnpm-lock.yaml tracked — ignore only pnpm debug/store logs
.pnpm-store/
.pnpm-debug.log

