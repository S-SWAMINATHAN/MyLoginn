generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role     @default(STUDENT)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  country       String?
  avatarColor   String   @default("#6366f1")
  avatarUrl     String?
  grade         String?
  board         String?
  points        Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments        Enrollment[]
  internshipApplications InternshipApplication[]
  tutoringBookings   TutoringBooking[]
  projects           Project[]
  mentoredProjects   Project[] @relation("MentorProjects")
  otpCodes           OtpCode[]
  notifications      Notification[]
  payments           Payment[]
  dailyActivities    DailyActivity[]
  pointsTransactions PointsTransaction[]
}

model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dateKey])
  @@index([userId])
}

model PointsTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  label     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ShowcaseProject {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  student     String
  result      String
  description String
  tags        String
  mentor      String
  sortOrder   Int    @default(0)
}

model OtpCode {
  id        String   @id @default(cuid())
  identifier String
  code      String
  purpose   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([identifier, purpose])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  category     String
  level        String
  description  String
  longDescription String?
  instructor   String
  instructorTitle String?
  durationWeeks Int
  price        Int
  originalPrice Int?
  rating       Float     @default(4.8)
  studentsCount Int      @default(0)
  imageColor   String    @default("#6366f1")
  tags         String
  syllabus     String
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments  Enrollment[]
  payments     Payment[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  status     String   @default("active")
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int
  currency          String   @default("INR")
  status            String   @default("created")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
}

model Tutor {
  id          String  @id @default(cuid())
  name        String
  subject     String
  bio         String
  qualification String
  experienceYears Int
  rating      Float   @default(4.9)
  avatarColor String  @default("#22c55e")
  boards      String

  bookings TutoringBooking[]
}

model TutoringBooking {
  id         String   @id @default(cuid())
  userId     String
  tutorId    String
  subject    String
  grade      String
  board      String
  preferredSlot String
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  tutor Tutor @relation(fields: [tutorId], references: [id])
}

model Internship {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  company     String
  type        String
  paid        Boolean  @default(true)
  stipend     Int?
  location    String
  durationWeeks Int
  description String
  requirements String
  responsibilities String
  mentorName  String
  mentorEmail String
  applyDeadline DateTime
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  applications InternshipApplication[]
}

model InternshipApplication {
  id           String   @id @default(cuid())
  userId       String
  internshipId String
  status       String   @default("submitted")
  coverNote    String?
  resumeName   String?
  appliedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  internship Internship @relation(fields: [internshipId], references: [id])

  @@unique([userId, internshipId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  mentorId    String?
  title       String
  description String
  status      String   @default("in_progress")
  progress    Int      @default(0)
  feedback    String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User  @relation(fields: [userId], references: [id])
  mentor User? @relation("MentorProjects", fields: [mentorId], references: [id])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  company     String?
  service     String
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
